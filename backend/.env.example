OPENAI_API_KEY=your_openai_api_key_here
# SerpAPI — Google Reverse Image + Lens matches (https://serpapi.com)
# Add your private key here; never commit the real value.
SERPAPI_KEY=your_serpapi_key_here
# Hive — deepfake / AI-generated video detection (https://thehive.ai)
HIVE_API_KEY=your_hive_api_key_here
# Google Fact Check Tools API — ClaimReview search (https://developers.google.com/fact-check/tools/api)
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here
# Extension API — Discord bot + browser extension (X-NomaeTrust-Key header)
EXTENSION_API_KEY=your_extension_api_key_here
# Public frontend URL for Action Card deep links
FRONTEND_BASE_URL=http://localhost:5173
# Discord bot (bots/discord — see bots/discord/.env.example)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
PORT=3001
