# NomaeTrust API — deploy at https://render.com (New Web Service, root directory: backend)
OPENAI_API_KEY=your_openai_api_key_here

# Required on Vercel: Project Settings → Environment Variables → Production
# SerpAPI — Google Reverse Image + Lens matches (https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Hive — deepfake video scoring for Digital Detective (optional)
HIVE_API_KEY=your_hive_api_key_here

# Google Fact Check Tools API — News Watch (optional, free API key)
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# Extension / Platform API auth (optional)
EXTENSION_API_KEY=your_extension_api_key_here

# Your Vercel frontend URL — required for CORS and Action Card deep links
FRONTEND_BASE_URL=https://your-app.vercel.app

PORT=3001
