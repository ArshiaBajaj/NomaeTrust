{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["server.ts", "app.ts", "routes/**/*.ts", "services/**/*.ts", "data/**/*.ts", "store/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
