# Frontend (Vite) — used at build time on Vercel
# Leave empty when vercel.json proxies /api to the Render backend (recommended).
VITE_API_URL=

# Optional: Platform admin API key (must match backend EXTENSION_API_KEY)
# VITE_EXTENSION_API_KEY=

# --- Backend (set on Render, NOT on Vercel) ---
# See backend/.env.example for OPENAI_API_KEY, SERPAPI_KEY, HIVE_API_KEY, etc.
